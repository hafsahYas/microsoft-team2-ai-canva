# Ollama API key — create one at https://ollama.com/settings/keys
# Used for all AI text generation (Research, Summarize, PRD, Slides, Code, etc.).
OLLAMA_API_KEY=your-ollama-api-key

# Ollama model (optional — defaults to deepseek-v4.1-flash)
# List available models on ollama.com via `curl https://ollama.com/api/tags`.
# Examples: deepseek-v4.1-flash, deepseek-v4.1-flash:cloud, llama3.3:70b, qwen3-coder:480b
# OLLAMA_MODEL=deepseek-v4.1-flash

# Ollama host (optional — defaults to https://ollama.com for Ollama Cloud)
# Point this at a local daemon to use local models instead:
# OLLAMA_HOST=http://localhost:11434

# Server port
PORT=3001

# fal.ai API key — get yours at https://fal.ai/dashboard/keys
# Used for image generation (cartoon profile pictures, etc.)
FAL_KEY=your-fal-key-here

# Google Stitch API key — get yours at https://stitch.withgoogle.com
STITCH_API_KEY=your-stitch-key-here

# Optional: GitHub token for the Code Map box (server).
# Public repositories are read without it; a token unlocks private repos and raises
# the API rate limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# Optional: here.now API key for the deploy button (server).
# Without it, deploys are ANONYMOUS Sites: live immediately but expire after 24
# hours, and they can only be updated with the claim token returned once at
# deploy time. With a key the Site is permanent and belongs to the account.
HERENOW_API_KEY=
